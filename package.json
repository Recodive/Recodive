{
	"author": "Recodive",
	"license": "MPL-2.0",
	"type": "module",
	"version": "1.8.4",
	"scripts": {
		"prepare": "husky",
		"dev": "pnpm -r dev",
		"build": "pnpm -r build",
		"test": "vitest --run",
		"test:watch": "vitest --ui",
		"test:ci": "vitest --run --coverage",
		"lint": "eslint --fix . && prettier -w .",
		"lint:ci": "eslint . && prettier --check .",
		"gen-badges": "vitest run --coverage && istanbul-badges-readme --logo=\"vitest\" && git add README.md",
		"release": "bumpp -r"
	},
	"dependencies": {
		"commitlint": "^18.0.0",
		"commitlint-plugin-function-rules": "^2.0.0",
		"eslint": "^8.57.0",
		"husky": "^9.0.11",
		"lint-staged": "^15.2.2",
		"prettier": "^3.2.5",
		"prompts": "^2.4.2"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.0.0",
		"@commitlint/lint": "^21.0.0",
		"@rushstack/eslint-patch": "^1.3.0",
		"@types/node": "^26.0.0",
		"@types/prompts": "^2.4.4",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^1.0.0",
		"bumpp": "^9.3.0",
		"istanbul-badges-readme": "^1.8.5",
		"typescript": "^5.0.4",
		"vitest": "^1.2.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Recodive/Recodive.git"
	},
	"packageManager": "pnpm@8.15.9",
	"pnpm": {
		"overrides": {
			"brace-expansion@>=1.0.0 <2.0.0": "^1.1.20",
			"brace-expansion@>=2.0.0 <3.0.0": "^2.1.6",
			"braces@>=3.0.0 <4.0.0": "^3.0.3",
			"browserslist@>=4.0.0 <5.0.0": "^4.28.7",
			"cross-spawn@>=7.0.0 <8.0.0": "^7.0.5",
			"defu@>=6.0.0 <7.0.0": "^6.1.5",
			"fflate@>=0.0.0 <1.0.0": "^0.8.3",
			"flatted@>=3.0.0 <4.0.0": "^3.4.2",
			"js-yaml@>=4.0.0 <5.0.0": "^4.3.2",
			"lodash@>=4.0.0 <5.0.0": "^4.18.0",
			"minimatch@>=3.0.0 <4.0.0": "^3.1.4",
			"minimatch@>=9.0.0 <10.0.0": "^11.0.0",
			"nanoid@>=3.0.0 <4.0.0": "^3.3.18",
			"picomatch@>=2.0.0 <3.0.0": "^2.3.2",
			"picomatch@>=4.0.0 <5.0.0": "^4.0.4",
			"postcss@>=8.0.0 <9.0.0": "^8.5.18",
			"rollup@>=4.0.0 <5.0.0": "^4.59.0",
			"source-map-js@>=1.0.0 <2.0.0": "^1.2.2"
		}
	}
}
